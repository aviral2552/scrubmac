#!/usr/bin/env bash
# Part of scrubmac — Copyright (C) 2018-2026 Aviral Sharma.
# Licensed GPL-3.0-only with an additional attribution term under
# GPLv3 section 7(b) — see the LICENSE and NOTICE files at the project root.
# scrubmac — maintenance for the dev tools on your Mac.
#
# Runs every enabled cleaner in cleaners/ (plus your own in
# ~/.config/scrubmac/cleaners.d/), each in its own process, and keeps going
# when one fails. See `scrubmac help`.
set -euo pipefail
export LC_ALL=C

# ---------- locate ourselves (through symlinks; no state files) ----------
CMM_SELF="${BASH_SOURCE[0]}"
while [ -L "$CMM_SELF" ]; do
  _dir="$(cd "$(dirname "$CMM_SELF")" && pwd)"
  CMM_SELF="$(readlink "$CMM_SELF")"
  case "$CMM_SELF" in
    /*) ;;
    *) CMM_SELF="$_dir/$CMM_SELF" ;;
  esac
done
CMM_ROOT="$(cd "$(dirname "$CMM_SELF")/.." && pwd)"
CMM_LIB="$CMM_ROOT/lib/common.sh"
export CMM_LIB
# shellcheck source=lib/common.sh
. "$CMM_LIB"
# shellcheck source=lib/dispatch.sh
. "$CMM_ROOT/lib/dispatch.sh"

CMM_VERSION="$(cat "$CMM_ROOT/VERSION" 2>/dev/null || echo 0.0.0)"

# ---------- refuse root (S1) ----------
if [ "${EUID:-$(id -u)}" -eq 0 ]; then
  err "scrubmac manages user-level tooling and must not run as root"
  exit 2
fi

# ---------- configuration ----------
cmm_migrate_config_dir # 2026 rename: adopt ~/.config/cleanmymac if present
cmm_init_paths
cmm_settings_snapshot_env
CMM__USER_OFFLINE="${CMM_OFFLINE:-}"

# ---------- usage ----------
usage() {
  cat <<EOF
${CMM_BOLD}scrubmac${CMM_RESET} $CMM_VERSION — one command to update and clean your dev tools

USAGE
  scrubmac [options] [cleaner ...]
  scrubmac <command> [args]

COMMANDS
  list [--names]           show all cleaners and their status
  status [cleaner ...]     read-only report: cache sizes and outdated packages
  doctor                   environment, configuration, and security report
  configure                (re)run the setup wizard
  enable <cleaner ...>     turn cleaners on
  disable <cleaner ...>    turn cleaners off
  config [get|set|unset|path] [KEY [VALUE]]
                           show or change settings (no args: list them all)
  schedule [daily|weekly|status|off] [DAY] [HH:MM]
                           run scrubmac automatically via launchd
  last [--json]            show the log of the most recent run
  update [--check]         update scrubmac itself
  version                  print the version
  help                     show this page

OPTIONS
  -n, --dry-run            print every command; run nothing that changes state
  -q, --quiet              hide cleaner output unless the cleaner fails
      --update-only        only update tools (skip cache cleanup)
      --clean-only         only clean caches (change no versions)
      --skip <cleaner>     leave a cleaner out of this run (repeatable)
      --measure            report the space each cleaner frees (slower)
      --json               machine-readable summary on stdout (output -> stderr)
      --scheduled          unattended run (set by 'scrubmac schedule')

Without arguments, every enabled cleaner runs. Naming cleaners runs exactly
those (even if disabled). Cleaners live in:
  $CMM_BUILTIN_CLEANERS_DIR
  $CMM_USER_CLEANERS_DIR   (yours; a same-named cleaner overrides the built-in)

EXIT STATUS
  0 all cleaners succeeded or were skipped; 1 at least one cleaner failed,
  timed out, or was refused; 2 usage or environment error; 130 interrupted.

PROJECT
  https://github.com/aviral2552/scrubmac
EOF
}

usage_err() {
  err "$1 (see 'scrubmac help')"
  exit 2
}

# ---------- argument parsing ----------
CMM_DRY_RUN=0
CMM_JSON=0
CMM_SCHEDULED=0
CMM_MODE=run
CMM_SKIP_NAMES=''
CMD=''
ARGS=()

set_mode() {
  if [ "$CMM_MODE" != run ] && [ "$CMM_MODE" != "$1" ]; then
    usage_err "--update-only and --clean-only are mutually exclusive"
  fi
  CMM_MODE="$1"
}

add_skip() {
  local n
  [ -n "$1" ] || usage_err "--skip needs a cleaner name"
  for n in ${1//,/ }; do
    CMM_SKIP_NAMES="$CMM_SKIP_NAMES $n"
  done
}

# shellcheck disable=SC2034  # CMM__FLAG_* are read indirectly by cmm_setting_resolve
while [ $# -gt 0 ]; do
  case "$1" in
    -n | --dry-run) CMM_DRY_RUN=1 ;;
    -q | --quiet) CMM__FLAG_QUIET=1 ;;
    --json) CMM_JSON=1 ;;
    --scheduled) CMM_SCHEDULED=1 ;;
    --measure) CMM__FLAG_MEASURE=1 ;;
    --update-only) set_mode update ;;
    --clean-only) set_mode clean ;;
    --skip)
      shift
      [ $# -gt 0 ] || usage_err "--skip needs a cleaner name"
      add_skip "$1"
      ;;
    --skip=*) add_skip "${1#--skip=}" ;;
    -h | --help) CMD=help ;;
    -V | --version) CMD=version ;;
    --)
      shift
      break
      ;;
    -*)
      case "$CMD:$1" in
        list:--names | update:--check) ARGS+=("$1") ;;
        *) usage_err "unknown option: $1" ;;
      esac
      ;;
    *)
      if [ -z "$CMD" ]; then
        case "$1" in
          list | doctor | status | configure | enable | disable | config | schedule | last | update | version | help) CMD="$1" ;;
          u | U) CMD=update ;; # legacy 1.x shorthands
          h | H) CMD=help ;;
          run) CMD=run ;;
          *)
            CMD=run
            ARGS+=("$1")
            ;;
        esac
      else
        ARGS+=("$1")
      fi
      ;;
  esac
  shift
done
[ $# -gt 0 ] && ARGS+=("$@")
: "${CMD:=run}"

if [ "$CMM_MODE" != run ] && [ "$CMD" != run ]; then
  usage_err "--update-only/--clean-only apply to runs only"
fi

# ---------- resolve settings (flag > env > config > default) ----------
cmm_settings_export
cmm_init_colors

CMM__TTY_OUT=0
[ -t 1 ] && CMM__TTY_OUT=1
CMM_INTERACTIVE=0
if [ "$CMM_SCHEDULED" != 1 ]; then
  if [ "${CMM_ASSUME_INTERACTIVE:-0}" = 1 ] || { [ -t 0 ] && [ -t 1 ]; }; then
    CMM_INTERACTIVE=1
  fi
fi
# --json: the JSON document owns stdout (fd 3 keeps it); everything else,
# cleaner output included, goes to stderr.
if [ "$CMM_JSON" = 1 ]; then
  exec 3>&1 1>&2
fi
export CMM_DRY_RUN CMM_MODE CMM_INTERACTIVE CMM_SCHEDULED CMM_OS

cmm_load_brew_prefix() {
  [ -n "${CMM__BREW_PREFIX_LOADED:-}" ] && return 0
  CMM__BREW_PREFIX_LOADED=1
  if [ -z "${CMM_BREW_PREFIX+x}" ]; then
    if have brew; then
      CMM_BREW_PREFIX="$(brew --prefix 2>/dev/null || true)"
    else
      CMM_BREW_PREFIX=""
    fi
  fi
  export CMM_BREW_PREFIX
}

# ---------- cleanup ----------
on_exit() {
  # Preserve the real exit status: a failing cleanup command in an EXIT trap
  # would otherwise become the script's status.
  local rc=$?
  cmm_locks_release
  if [ -n "$CMM_TMP" ]; then
    rm -rf "$CMM_TMP"
  fi
  exit "$rc"
}
trap on_exit EXIT

# ---------- subcommands ----------
write_default_config() {
  mkdir -p "$CMM_CONFIG_DIR"
  cmm_write_file_atomic "$CMM_CONFIG_FILE" <<EOF
# scrubmac configuration — KEY=value, one per line.
# Values may contain only A-Z a-z 0-9 . _ / - ; this file is parsed, never
# executed. 'scrubmac config' lists every setting; 'scrubmac configure'
# re-runs the wizard.
COOLDOWN_DAYS=7
APP_UPDATES=interactive
QUIET=0
COLOR=auto
EOF
}

first_run_offer() {
  [ -f "$CMM_CONFIG_FILE" ] && return 0
  if [ "${CMM_WIZARD_ASSUME_TTY:-0}" = "1" ] || { [ -t 0 ] && [ -t 1 ]; }; then
    printf 'No configuration found. Run the setup wizard now? [Y/n] '
    local a=""
    IFS= read -r a || a=n
    case "$a" in
      n | N | no | NO)
        write_default_config
        note "Wrote defaults to $CMM_CONFIG_FILE — run 'scrubmac configure' anytime."
        ;;
      *)
        # shellcheck source=lib/wizard.sh
        . "$CMM_ROOT/lib/wizard.sh"
        wizard_main firstrun
        # The wizard just wrote config: re-resolve the settings computed
        # from defaults before it ran.
        cmm_settings_export
        cmm_init_colors
        ;;
    esac
  else
    note "(no config found — using defaults; run 'scrubmac configure' to customize)"
  fi
}

# cmm__skipped_run REASON — record a scheduled run that chose not to run.
cmm__skipped_run() {
  note "scheduled run skipped: $1"
  cmm__open_log
  cmm_log "scrubmac $CMM_VERSION — $(cmm_now_iso) — scheduled run skipped: $1"
  cmm__rotate_logs
}

cmd_run() {
  local n last now
  for n in "$@"; do
    known_cleaner "$n" || cmm_unknown_cleaner "$n"
  done
  for n in $CMM_SKIP_NAMES; do
    known_cleaner "$n" || cmm_unknown_cleaner "$n"
  done
  cmm_state_migrate
  if [ "$#" -eq 0 ] && [ "$CMM_SCHEDULED" != 1 ]; then
    first_run_offer
  fi

  if [ "$CMM_SCHEDULED" = 1 ]; then
    if [ "$CMM_ON_BATTERY" = skip ] && cmm_on_battery; then
      cmm__skipped_run "on battery power (ON_BATTERY=skip)"
      exit 0
    fi
    if [ "$CMM_MIN_HOURS_BETWEEN_RUNS" -gt 0 ] && [ -f "$CMM_LAST_SUCCESS_FILE" ]; then
      last="$(cat "$CMM_LAST_SUCCESS_FILE" 2>/dev/null || true)"
      now="$(date '+%s')"
      case "$last" in
        '' | *[!0-9]*) ;;
        *)
          if [ $((now - last)) -lt $((CMM_MIN_HOURS_BETWEEN_RUNS * 3600)) ]; then
            cmm__skipped_run "a full run succeeded $(((now - last) / 3600))h ago (MIN_HOURS_BETWEEN_RUNS=$CMM_MIN_HOURS_BETWEEN_RUNS)"
            exit 0
          fi
          ;;
      esac
    fi
  fi

  cmm_lock_acquire
  cmm_legacy_lock_acquire
  cmm_detect_offline
  cmm_load_brew_prefix
  export CMM_OFFLINE

  note "${CMM_BOLD}scrubmac $CMM_VERSION${CMM_RESET} — starting up the cleaning engines"
  [ "$CMM_DRY_RUN" = "1" ] && note "(dry run: commands are printed; nothing that changes state is executed)"
  case "$CMM_MODE" in
    update) note "(update-only: caches are left alone)" ;;
    clean) note "(clean-only: no versions change)" ;;
  esac
  [ "$CMM_OFFLINE" = 1 ] && note "(offline: no default network route — updates are skipped, cleanup still runs)"

  local rc=0
  cmm_run_cleaners "$@" || rc=$?
  exit "$rc"
}

cmd_status() {
  local n
  for n in "$@"; do
    known_cleaner "$n" || cmm_unknown_cleaner "$n"
  done
  for n in $CMM_SKIP_NAMES; do
    known_cleaner "$n" || cmm_unknown_cleaner "$n"
  done
  cmm_state_migrate
  cmm_detect_offline
  cmm_load_brew_prefix
  CMM_MODE=status
  export CMM_MODE CMM_OFFLINE
  note "${CMM_BOLD}scrubmac $CMM_VERSION status${CMM_RESET} — read-only: nothing is changed"
  local rc=0
  cmm_run_cleaners "$@" || rc=$?
  exit "$rc"
}

cmd_list() {
  local name base path src gate group def summary state
  cmm_state_migrate
  if [ "${1:-}" = --names ]; then
    cmm_cleaner_names
    return 0
  fi
  cmm_discover
  printf '%-16s %-9s %-7s %-5s %-8s %s\n' NAME STATE DEFAULT TOOL SOURCE SUMMARY
  while IFS="$TAB" read -r name base path src gate group def summary; do
    [ -n "$name" ] || continue
    state=enabled
    cmm_is_enabled "$name" "$def" || state=disabled
    [ "$summary" = - ] && summary=''
    printf '%-16s %-9s %-7s %-5s %-8s %s\n' "$name" "$state" "$def" "$(cmm_tool_present "$gate")" "$src" "$summary"
  done <<EOF
$CMM_DISCOVERED
EOF
}

cmd_enable_disable() {
  local want="$1" n gate
  shift
  [ "$#" -gt 0 ] || usage_err "usage: scrubmac $CMD <cleaner ...>"
  for n in "$@"; do
    known_cleaner "$n" || cmm_unknown_cleaner "$n"
  done
  cmm_state_migrate
  for n in "$@"; do
    cmm_set_state "$n" "$want"
    if [ "$want" = on ]; then
      gate="$(cmm_cleaner_field "$n" 5)"
      if [ "$(cmm_tool_present "$gate")" = - ]; then
        note "enabled: $n (its tool is not installed yet — it will skip until it is)"
      else
        note "enabled: $n"
      fi
    else
      note "disabled: $n"
    fi
  done
}

# cmm_config_put KEY [VALUE] — rewrite the config file without KEY (any line
# assigning it, valid or not), then append KEY=VALUE when a value is given.
# Comments and every other line are preserved.
cmm_config_put() {
  local key="$1" nargs="$#" val="${2:-}"
  mkdir -p "$CMM_CONFIG_DIR"
  {
    if [ -f "$CMM_CONFIG_FILE" ]; then
      grep -v -E "^[[:space:]]*${key}[[:space:]]*=" "$CMM_CONFIG_FILE" || true
    fi
    if [ "$nargs" -eq 2 ]; then
      printf '%s=%s\n' "$key" "$val"
    fi
  } | cmm_write_file_atomic "$CMM_CONFIG_FILE"
}

cmm__valid_key() {
  case "$1" in
    '' | [!A-Z]* | *[!A-Z0-9_]*) return 1 ;;
  esac
  return 0
}

cmd_config() {
  local sub="${1:-list}" key line custom=''
  [ "$#" -gt 0 ] && shift
  case "$sub" in
    list)
      printf '%-24s %-12s %-8s %s\n' KEY VALUE SOURCE DESCRIPTION
      for key in $(cmm_setting_keys); do
        cmm_setting_resolve "$key" || true
        printf '%-24s %-12s %-8s %s\n' "$key" "$CMM__S_VAL" "$CMM__S_SRC" "$CMM__S_DESC"
      done
      if [ -f "$CMM_CONFIG_FILE" ]; then
        while IFS= read -r line; do
          key="${line%%=*}"
          cmm_setting_info "$key" && continue
          case " $custom " in *" $key "*) continue ;; esac
          custom="$custom $key"
          printf '%-24s %-12s %-8s %s\n' "$key" "$(config_get "$key" "")" custom "(not a built-in setting; read by custom cleaners)"
        done <<EOF
$(grep -E '^[A-Z][A-Z0-9_]*=[A-Za-z0-9._/-]*$' "$CMM_CONFIG_FILE" 2>/dev/null || true)
EOF
      fi
      note ""
      note "config file: $CMM_CONFIG_FILE   (CMM_<KEY> in the environment overrides a setting for one run)"
      ;;
    get)
      [ "$#" -eq 1 ] || usage_err "usage: scrubmac config get KEY"
      cmm__valid_key "$1" || usage_err "invalid key '$1' (expected A-Z, 0-9, _)"
      cmm_setting_resolve "$1" || true
      note "$CMM__S_VAL"
      ;;
    set)
      [ "$#" -eq 2 ] || usage_err "usage: scrubmac config set KEY VALUE"
      cmm__valid_key "$1" || usage_err "invalid key '$1' (expected A-Z, 0-9, _)"
      case "$2" in
        *[!A-Za-z0-9._/-]*) usage_err "invalid value '$2' (allowed: A-Z a-z 0-9 . _ / -)" ;;
      esac
      if cmm_setting_info "$1"; then
        cmm_setting_valid "$CMM__S_TYPE" "$2" ||
          usage_err "invalid value for $1: '$2' (expected $(cmm_type_hint "$CMM__S_TYPE"))"
      else
        warn "$1 is not a built-in setting — stored for custom cleaners"
      fi
      cmm_config_put "$1" "$2"
      note "$1=$2"
      ;;
    unset)
      [ "$#" -eq 1 ] || usage_err "usage: scrubmac config unset KEY"
      cmm__valid_key "$1" || usage_err "invalid key '$1' (expected A-Z, 0-9, _)"
      cmm_config_put "$1"
      note "unset $1"
      ;;
    path) note "$CMM_CONFIG_FILE" ;;
    *) usage_err "usage: scrubmac config [list|get KEY|set KEY VALUE|unset KEY|path]" ;;
  esac
}

cmd_last() {
  local latest
  if [ "$CMM_JSON" = 1 ]; then
    if [ -f "$CMM_LAST_RUN_FILE" ]; then
      cat "$CMM_LAST_RUN_FILE" >&3
      return 0
    fi
    err "no runs recorded yet"
    exit 1
  fi
  latest="$(cmm__log_files | awk 'NR == 1')"
  if [ -z "$latest" ]; then
    note "no runs recorded yet (logs live in $CMM_LOG_DIR)"
    return 0
  fi
  cat "$CMM_LOG_DIR/$latest"
}

cmd_version() {
  local sha=""
  if [ -d "$CMM_ROOT/.git" ] && have git; then
    sha=" ($(git -C "$CMM_ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown))"
  fi
  note "scrubmac $CMM_VERSION$sha"
}

case "$CMD" in
  run) cmd_run ${ARGS[@]+"${ARGS[@]}"} ;;
  status) cmd_status ${ARGS[@]+"${ARGS[@]}"} ;;
  list) cmd_list ${ARGS[@]+"${ARGS[@]}"} ;;
  doctor)
    cmm_load_brew_prefix
    # shellcheck source=lib/doctor.sh
    . "$CMM_ROOT/lib/doctor.sh"
    cmd_doctor
    ;;
  configure)
    cmm_state_migrate
    # shellcheck source=lib/wizard.sh
    . "$CMM_ROOT/lib/wizard.sh"
    wizard_main
    ;;
  enable) cmd_enable_disable on ${ARGS[@]+"${ARGS[@]}"} ;;
  disable) cmd_enable_disable off ${ARGS[@]+"${ARGS[@]}"} ;;
  config) cmd_config ${ARGS[@]+"${ARGS[@]}"} ;;
  schedule)
    cmm_load_brew_prefix
    # shellcheck source=lib/schedule.sh
    . "$CMM_ROOT/lib/schedule.sh"
    cmd_schedule ${ARGS[@]+"${ARGS[@]}"}
    ;;
  last) cmd_last ;;
  update)
    cmm_load_brew_prefix
    # shellcheck source=lib/update.sh
    . "$CMM_ROOT/lib/update.sh"
    cmd_update ${ARGS[@]+"${ARGS[@]}"}
    ;;
  version) cmd_version ;;
  help) usage ;;
esac
